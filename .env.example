# ============================================================
# LLM
# ============================================================
LLM_PROVIDER=gemini

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=models/gemini-2.5-flash

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=qwen/qwen3.8-27b

# ============================================================
# Embeddings
# ============================================================
EMBEDDING_MODEL_NAME=minilm
# (alias resolved to sentence-transformers/all-MiniLM-L6-v2)

# ============================================================
# Vector Store
# ============================================================
CHROMA_DIR=data/chroma

# ============================================================
# RAG Controls
# ============================================================
MIN_RELEVANCE_SCORE=0.3
EXTRACTIVE_SCORE_THRESHOLD=0.65
ROUTER_LONG_QUERY_WORD_THRESHOLD=100

# ============================================================
# Retrieval
# ============================================================
DEFAULT_TOP_K=5

# ============================================================
# Auth / Database
# ============================================================
AUTH_SECRET_KEY=replace-with-a-long-random-string
SQLITE_DB_PATH=data/app.db

# ============================================================
# Confluence (MCP) — leave blank to disable
# ============================================================
CONFLUENCE_URL=https://your-site.atlassian.net
CONFLUENCE_USER=your-email@example.com
CONFLUENCE_API_TOKEN=your-api-token-here
CONFLUENCE_SPACE_KEY=YOUR_SPACE_KEY

# ============================================================
# Git (MCP) — leave blank to disable
# ============================================================
GIT_REPO_URL= "https://github.com/musadiq-ciklum/linkedin-agent.git"
GIT_LOCAL_PATH=data/git_repos
GIT_TOKEN=your_github_token_here
GIT_EXTENSIONS=.md,.txt,.rst,.py
