flowchart TB
    %% =========================
    %% Users
    %% =========================
    UserBrowser[Browser User]
    UserAPI[API Client]
    UserCLI[CLI User]

    %% =========================
    %% Entry Points
    %% =========================
    StreamlitApp["Streamlit App\n(app.py)"]
    API["FastAPI + Uvicorn\n(/ask · /ask/stream · /embedding · /upload)"]
    CLI["rag_run.py"]

    %% =========================
    %% Auth & Persistence
    %% =========================
    AuthService["Auth Service\n(bcrypt · itsdangerous)"]
    SQLite[("SQLite\nUsers · Sessions · Messages")]

    %% =========================
    %% Pipeline & Routing
    %% =========================
    Pipeline["RAG Pipeline\n(run_with_context · stream_with_context)"]
    Controller["AgentController\n(ROUTES table)"]

    %% =========================
    %% MCP Sources
    %% =========================
    MCPServer["MCP Server\n(FastMCP)"]
    ConfluenceSource["Confluence Source\n(Atlassian REST API)"]
    GitSource["Git Source\n(GitPython)"]

    %% =========================
    %% Retrieval Layer
    %% =========================
    Retriever["Semantic Search Retriever"]
    Reranker["CrossEncoder Reranker\n(ms-marco-MiniLM-L-6-v2)"]
    VectorStore[("Chroma Vector Store")]

    %% =========================
    %% Models
    %% =========================
    LLM["Gemini LLM\n(generate · stream)"]
    Embedder["Sentence-Transformers\n(MiniLM)"]

    %% =========================
    %% Data Ingestion
    %% =========================
    Upload["Document Upload\n(.txt · .pdf)"]
    Chunking["Text Cleaning & Chunking"]

    %% =========================
    %% Evaluation (Offline)
    %% =========================
    EvalScript["eval_rag.py"]
    EvalData["Evaluation Dataset (JSON)"]
    Metrics["Precision@K · Recall@K\nRAG Quality · Latency"]
    Reports["CSV Reports"]

    %% ── Entry flows ──────────────────────────
    UserBrowser --> StreamlitApp
    UserAPI --> API
    UserCLI --> CLI

    %% ── Auth & chat history ──────────────────
    StreamlitApp --> AuthService --> SQLite
    StreamlitApp --> SQLite

    %% ── All interfaces call Pipeline directly ─
    StreamlitApp --> Pipeline
    API --> Pipeline
    CLI --> Pipeline

    %% ── Pipeline consults Controller ─────────
    Pipeline --> Controller

    %% ── Controller returns routing decision ──
    %% ── Pipeline then calls the right handler ─
    Controller -->|retrieve| Retriever
    Controller -->|generate| LLM
    Controller -->|confluence| MCPServer
    Controller -->|git| MCPServer

    %% ── MCP sources ──────────────────────────
    MCPServer --> ConfluenceSource
    MCPServer --> GitSource
    MCPServer -->|results| LLM

    %% ── Retrieve path ────────────────────────
    Retriever --> VectorStore --> Retriever
    Retriever --> Reranker --> LLM
    Retriever --> Embedder

    %% ── Data ingestion ───────────────────────
    Upload --> Chunking --> Embedder --> VectorStore

    %% ── Evaluation ───────────────────────────
    EvalData --> EvalScript
    EvalScript --> Retriever
    EvalScript --> Reranker
    EvalScript --> LLM
    EvalScript --> Metrics --> Reports
